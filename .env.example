# Google Gemini API Key (dung cho ca /api/ai-personalize.js va client-side AI)
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Huong dan lay key:
# 1. Vao https://aistudio.google.com/app/apikey
# 2. Tao API key moi
# 3. Copy va dan vao day (thay "your_gemini_api_key_here")
# 4. Them vao Vercel: Project Settings -> Environment Variables -> GEMINI_API_KEY
